# ---- GeoSAR Drishti environment template ----
# Copy to services/api/.env (backend) and apps/web/.env (frontend). Never commit real values.

# ===== Backend (services/api) =====
# NASA Earthdata Bearer token for /api/v1/nisar/earthdata-live (optional; falls back to cache if blank)
EARTHDATA_TOKEN=

# CORS: "*" for demo, or your frontend origin e.g. https://geosardrishti.cosmosinfoverse.tech
CORS_ORIGINS=*

# Optional LLM narrator for Evidence Cards. Paste ONLY your OpenAI API key here.
# Blank key = 100% deterministic templates (the app works fully without it).
# Defaults: base = https://api.openai.com/v1, model = gpt-4o-mini (cheap, fast, good enough).
# Uncomment to change the model / use another OpenAI-compatible provider (Groq / OpenRouter / ...).
LLM_API_KEY=
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_FALLBACK_MODELS=gpt-4.1-mini

# ---- Where your data lives (optional; defaults keep everything inside the repo) ----
# NISAR .h5 granules (big!). Default: ./DATA   -> e.g. D:/Hackathon Files
# GEOSAR_DATA_DIR=
# Analysed packs written by analyze (cube + overlays). Default: services/api/data_store  -> e.g. D:/geosar_packs
# GEOSAR_DATA_STORE=

# External call timeout (seconds)
EXTERNAL_TIMEOUT_SECONDS=3.5

# ===== Frontend (apps/web) =====
# Base URL of the deployed FastAPI service
VITE_API_BASE_URL=http://localhost:8000
