{
  "name": "ict-geosar-drishti",
  "version": "0.1.0",
  "private": true,
  "description": "GeoSAR Drishti — NASA-ISRO NISAR L-band monsoon water intelligence (CH-06). Monorepo: React telemetry UI + FastAPI server.",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "bash run.sh",
    "dev:fast": "bash run.sh --no-install",
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "web:preview": "npm --workspace apps/web run preview",
    "api:dev": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --app-dir services/api",
    "api:install": "pip install -r services/api/requirements.txt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/InfoVerse-Cosmos/ICT-GeoSARDrishti.git"
  },
  "license": "MIT"
}
